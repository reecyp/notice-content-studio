# Postgres (Neon) for the send ledger: which video went to TikTok and when.
# Optional. Leave it unset and the studio runs exactly as it did without a
# database. Apply the schema with `npm run db:init`. See docs/database.md.
DATABASE_URL=

# TikTok for Developers -> Manage apps -> your app.
# Copy to .env.local and fill in. Never commit the filled version.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Must exactly match a redirect URI registered on the app. Absolute https, no
# query string, no fragment. Leave unset to use <this origin>/api/tiktok/callback.
TIKTOK_REDIRECT_URI=

# The origin TikTok fetches tile PNGs from. Must sit under a domain or URL
# prefix verified in the app's URL properties. Leave unset to use this origin.
TIKTOK_PUBLIC_BASE=

# A photo post accepts only WebP and JPEG. WebP is the default; set this to
# jpeg only if TikTok ever fails to pull the WebP tiles.
TIKTOK_IMAGE_FORMAT=
