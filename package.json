{
  "name": "notice-content-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "build:check": "NEXT_DIST_DIR=.next-check next build",
    "start": "next start -p 3210",
    "check": "tsc --noEmit && node scripts/uid.mjs --check && node scripts/check-fonts.mjs && node scripts/check-layout.mjs && npm run check:db",
    "check:db": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-ledger.mjs",
    "uid": "node scripts/uid.mjs",
    "db:init": "node --env-file-if-exists=.env.local scripts/db-init.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@neondatabase/serverless": "^1.1.0",
    "next": "^15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.6"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "sharp": "^0.35.4"
  }
}
