    {
      "role": "point",
      "points": [
        {
          "number": 1,
          "title": "Fast for 24 hours",
          "body": [
            {
              "kind": "paragraph",
              "hug": true,
              "text": "Hunger exposes who is in control."
            },
            {
              "kind": "paragraph",
              "text": "Your body will beg. Your mind will negotiate."
            },
            {
              "kind": "paragraph",
              "text": "Watch how quickly excuses appear."
            },
            {
              "kind": "paragraph",
              "text": "Discipline begins when you refuse them."
            }
          ]
        }
      ]
    },
    {
      "role": "point",
      "points": [
        {
          "number": 2,
          "title": "Walk 20 miles in one day",
          "body": [
            {
              "kind": "paragraph",
              "hug": true,
              "text": "No music. No podcasts. Just movement."
            },
            {
              "kind": "paragraph",
              "text": "Fatigue strips identity down to essentials."
            },
            {
              "kind": "paragraph",
              "text": "Thoughts rise and fall naturally."
            },
            {
              "kind": "paragraph",
              "text": "You learn how you speak to yourself under strain."
            }
          ]
        }
      ]
    },
    {
      "role": "point",
      "points": [
        {
          "number": 3,
          "title": "Cut all sugar for 21 days",
          "body": [
            {
              "kind": "paragraph",
              "hug": true,
              "text": "Cravings reveal dependency."
            },
            {
              "kind": "paragraph",
              "text": "Mood swings expose weak regulation."
            },
            {
              "kind": "paragraph",
              "text": "Energy stabilizes slowly."
            },
            {
              "kind": "paragraph",
              "text": "You realize how much pleasure controlled you."
            }
          ]
        }
      ]
    },
    {
      "role": "point",
      "points": [
        {
          "number": 4,
          "title": "Sleep under the open sky",
          "body": [
            {
              "kind": "paragraph",
              "hug": true,
              "text": "No walls. No roof. No comfort."
            },
            {
              "kind": "paragraph",
              "text": "The nervous system recalibrates fast."
            },
            {
              "kind": "paragraph",
              "text": "Fear passes. Awareness sharpens."
            },
            {
              "kind": "paragraph",
              "text": "You remember how small and alive you are."
            }
          ]
        }
      ]
    },
    {
      "role": "point",
      "points": [
        {
          "number": 5,
          "title": "Wake up at 5 AM for 30 days",
          "body": [
            {
              "kind": "paragraph",
              "hug": true,
              "text": "The world feels different before it wakes."
            },
            {
              "kind": "paragraph",
              "text": "Discipline compounds quietly here."
            },
            {
              "kind": "paragraph",
              "text": "Momentum builds without applause."
            },
            {
              "kind": "paragraph",
              "text": "You start trusting yourself again."
            }
          ]
        }
      ]
    },
    {
